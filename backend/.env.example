# Copy to .env and fill in. Never commit the filled-in file.

# ── Required ──────────────────────────────────────────────────────────────────

# Atlas connection string. Vector search is an Atlas feature — a local mongod
# will run the app but RAG stays disabled (the boot log says so explicitly).
# Replace <db_username> and <db_password> with a Database Access user, and
# percent-encode any of @ : / ? # [ ] % in the password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/veil?retryWrites=true&w=majority

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE=7d

# Groq — powers turn analysis, fallacy detection, the AI opponent and scoring.
GROK_API_KEY=gsk_...

# HuggingFace — all-MiniLM-L6-v2 embeddings (384-d).
HUGGINGFACE_API_KEY=hf_...

# ── Optional ──────────────────────────────────────────────────────────────────

PORT=5001

# Extra browser origins allowed by both HTTP CORS and the Socket.io handshake.
# Comma-separated. localhost:3000 and the Vercel domains are always allowed.
FRONTEND_URL=

# Redis. Absent, caching is skipped and rate limits fall back to per-process
# counters — the app runs fine, limits just are not shared across instances.
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Perspective API for toxicity scoring. Without it, scoring falls back to
# the LLM, then to a keyword heuristic.
PERSPECTIVE_API_KEY=

# Encryption key for anonymous feedback author IDs.
SLICK_ENCRYPTION_KEY=generate-a-long-random-string

# ── Tuning ────────────────────────────────────────────────────────────────────

AI_CACHE_TTL=300               # seconds
AI_RATE_LIMIT_PER_HOUR=10      # LLM calls per user per hour
AI_RATE_LIMIT_PER_MINUTE=20    # /api/ai requests per minute
RATE_LIMIT_PER_MINUTE=120      # all /api requests per minute
AUTH_RATE_LIMIT=20             # login/register attempts per 15 minutes

EMBEDDING_CACHE_SIZE=5000      # vectors held in process
FEED_CACHE_TTL=120             # seconds
FEED_RANKED_DEPTH=60           # posts ranked per precompute
FEED_STALE_AFTER_SECONDS=600   # when a ranking is refreshed behind the response
FEED_PRECOMPUTE_ENABLED=true

FALLACY_LLM_ENABLED=true       # false = regex layer only, no model cost

# Anonymous feedback about users outside your shared communities. Off by
# default: shared context is the only thing preventing targeted harassment.
ALLOW_PLATFORM_WIDE_SLICKS=false
